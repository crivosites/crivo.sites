# ------------------------------------------------------------------
# Variáveis de ambiente opcionais (copie para .env.local)
# ------------------------------------------------------------------

# Endereço oculto do painel de conteúdo (padrão: /painel-interno)
ADMIN_PATH=/painel-interno

# URL final do site publicado (usada no SEO, sitemap e links canônicos).
# Se vazio, usa o campo meta.siteUrl de content/site-config.json
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Chave extra de proteção da API de conteúdo (opcional).
# Se definida, o painel precisa enviar o cabeçalho x-admin-key.
ADMIN_KEY=

# Código de verificação do Google Search Console (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Origens autorizadas no servidor de desenvolvimento (separadas por vírgula).
# Necessário quando você abre o site por um host diferente de localhost
# (ex.: um preview remoto). Sem isso o next dev bloqueia os recursos internos
# e a página não hidrata: botões, menu e carrossel deixam de funcionar.
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# ------------------------------------------------------------------
# Salvar pelo painel em host serverless (Vercel, etc.)
# ------------------------------------------------------------------
# Nesses hosts o disco é somente-leitura. Defina o repositório e um token do
# GitHub (permissão "Contents: Read and write") e o painel grava
# content/site-config.json direto no repositório. O site lê a versão mais
# recente de lá a cada requisição, então o "Salvar" aparece sem recompilar.
# (Em host com disco gravável — VPS/Docker/pnpm start — isto é opcional.)
# NUNCA versione o valor do token: ele vive só no painel de variáveis do host.
# Escopo mínimo: fine-grained, permissão "Contents: Read and write".
# Na Vercel o repositório é descoberto sozinho (o deployment informa dono/repo),
# então normalmente basta definir GITHUB_TOKEN. Preencha GITHUB_REPO apenas se
# estiver em outro host ou se quiser forçar um repositório diferente.
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main
GITHUB_CONFIG_PATH=content/site-config.json
